# === Local workaround / one-off repair scripts (kept local, not shipped) ===
# The underlying issues are fixed in the pipeline itself; these only regenerate
# or repair outputs from older runs.
run_artemis_assessment.R
fix_cohort_counts.R
refresh_concept_details.R
sync_atlas.R
run_update.R
R/update_cohorts.R

# === Claude / agent tooling (never commit) ===
.claude/
CLAUDE.md
.cursor/
.aider*

# === Granular internal notes / working documentation ===
DEVELOPMENT.md
docs/

# === Source binaries (protocol drafts, reference PDFs) ===
*.docx
*.pdf

# === Results (aggregate outputs — regenerated per run) ===
results/
!results/.gitkeep
results_*/

# === Resumable-state checkpoints (patient-level; not part of any output) ===
.cache/

# === R session / RStudio ===
.Rproj.user/
.Rhistory
.RData
.Ruserdata
*.Rproj.user

# === JDBC drivers / credentials ===
*.jar
.jdbc_drivers/
db_config.yaml
config/
results_live/

# === renv — commit renv.lock only; the restored library is machine-local ===
renv/library/
renv/local/
renv/cellar/
renv/staging/
renv/python/
renv/sandbox/

# === OS ===
.DS_Store

# === DatabaseConnector debug output (written on a SQL error; may contain
# schema/SQL details) ===
errorReportSql.txt

# === Local environment / secrets ===
.env

# ===========================================================================
# .env.example — copy to .env and fill in. .env is git-ignored.
# ===========================================================================
# Read by configureFromEnv() in R/env_config.R, which returns the
# `connectionDetails` + `settings` objects run.R's CONFIG block otherwise
# builds by hand. Nothing secret belongs in a tracked file.
#
# NOTE: the study's own work-table names (bc_cohort, bc_lab_cohort, ...) are
# NOT read from here — see the header of R/env_config.R for why.

# --- Database connection ---------------------------------------------------
# OSM_DBMS is any DatabaseConnector dialect: snowflake, postgresql,
# "sql server", redshift, oracle, ...
OSM_DBMS=snowflake
OSM_CONNECTION_STRING=jdbc:snowflake://<account>.snowflakecomputing.com/?db=<DB>
OSM_USER=
OSM_PASSWORD=
# Snowflake only: appended to the connection string when it names no warehouse.
OSM_SNOWFLAKE_WAREHOUSE=COMPUTE_WH

# Folder holding the JDBC driver jars ("~" is expanded).
DATABASECONNECTOR_JAR_FOLDER=~/.jdbc_drivers

# --- Schemas ---------------------------------------------------------------
OSM_CDM_SCHEMA=CDM
OSM_VOCAB_SCHEMA=CDM
# Where this study writes its cohort / lab / episode tables.
OSM_WORK_SCHEMA=OMOP_RESULTS

# --- Run settings ----------------------------------------------------------
# Short site id that appears in the result tables.
OSM_DATABASE_ID=MY_SITE
# Privacy threshold — patient/record counts below this are censored.
OSM_MIN_CELL_COUNT=5
# Local folder for CSV outputs.
OSM_OUTPUT_FOLDER=results
